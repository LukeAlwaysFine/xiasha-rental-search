# 环境变量模板，复制为 .env 并填入真实值
# 不要提交 .env 到 git

# LLM API (通义千问或 DeepSeek)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# LLM_CONCURRENCY=40  # 并行 LLM 请求数，默认 40（按 500 RPM 配置）

# 高德地图 API Key (https://console.amap.com/)
# 后端 geocode 用：选"Web服务"
AMAP_API_KEY=your_web_service_key_here
# 前端地图展示用：选"Web端(JS API)"
AMAP_JS_KEY=your_js_api_key_here

# Firecrawl API (https://www.firecrawl.dev/pricing 免费 1000 credits/月)
# 云 API 模式（默认）: 填 API Key
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# 自部署模式: 填 http://localhost:3002 并留空 API Key
FIRECRAWL_URL=https://api.firecrawl.dev
